{
  "name": "password-generator-app",
  "version": "1.1.0",
  "main": "index.tsx",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --max-workers 1 && node scripts/prepare-static.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.*",
    "lint": "eslint index.tsx app src tests scripts playwright.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "preview": "node scripts/serve.mjs"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-status-bar": "~57.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "react-dom": "19.2.3",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "~57.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.4",
    "@eslint/js": "9.39.4",
    "typescript-eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "@types/node": "22.19.15"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
